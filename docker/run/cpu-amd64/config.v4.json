{
  "schema_version": 4,
  "app": {
    "opendatacam_version": "3.0.2",
    "valid_classes": ["bicycle", "person", "truck", "motorbike", "car", "bus"],
    "display_classes": [
      { "class": "bicycle", "hexcode": "1F6B2" },
      { "class": "person", "hexcode": "1F6B6" },
      { "class": "truck", "hexcode": "1F69B" },
      { "class": "motorbike", "hexcode": "1F6F5" },
      { "class": "car", "hexcode": "1F697" },
      { "class": "bus", "hexcode": "1F68C" }
    ]
  },
  "inference": {
    "backend": "darkhelp",
    "darknet_repo": "https://codeberg.org/CCodeRun/darknet",
    "darknet_ref": "master",
    "darknet_commit": "a3df422adf773c87cc6af1dd0a577e87847ae081",
    "darkhelp_commit": "8bf10619cf10776b30ac157fca80cf0043452b40",
    "sidecar": {
      "base_url": "http://inference-sidecar:9080",
      "runtime": {
        "darkhelp_enabled": true,
        "darkhelp_cfg": "/opt/models/model.cfg",
        "darkhelp_weights": "/opt/models/model.weights",
        "darkhelp_names": "/opt/models/model.names",
        "darkhelp_threshold": 0.25,
        "video_source": "/opt/video/input.mp4",
        "video_loop": true,
        "mjpeg_quality": 80
      }
    }
  },
  "video": {
    "input": "file",
    "upload_folder": "/var/local/opendatacam/opendatacam_videos_uploaded",
    "inputs": {
      "file": "opendatacam_videos/demo.mp4",
      "usbcam": "v4l2src device=/dev/video0 ! video/x-raw, framerate=30/1, width=640, height=360 ! videoconvert ! appsink",
      "raspberrycam": "nvarguscamerasrc ! video/x-raw(memory:NVMM),width=1280, height=720, framerate=30/1, format=NV12 ! nvvidconv ! video/x-raw, format=BGRx, width=640, height=360 ! videoconvert ! video/x-raw, format=BGR ! appsink",
      "remote_cam": "YOUR IP CAM STREAM (can be .m3u8, MJPEG ...), anything supported by opencv",
      "remote_hls_gstreamer": "souphttpsrc location=http://YOUR_HLSSTREAM_URL_HERE.m3u8 ! hlsdemux ! decodebin ! videoconvert ! videoscale ! appsink",
      "simulation": "--yolo_json public/static/placeholder/alexeydetections30FPS.json --video_file_or_folder public/static/placeholder/frames --isLive true --jsonFps 20 --mjpgFps 0.2"
    }
  },
  "tracking": {
    "settings": {
      "objectMaxAreaInPercentageOfFrame": 80,
      "confidence_threshold": 0.2,
      "iouLimit": 0.05,
      "unMatchedFrameTolerance": 5,
      "fastDelete": true,
      "matchingAlgorithm": "kdTree"
    }
  },
  "counting": {
    "settings": {
      "countingAreaMinFramesInsideToBeCounted": 1,
      "countingAreaVerifyIfObjectEntersCrossingOneEdge": true,
      "minAngleWithCountingLineThreshold": 5,
      "computeTrajectoryBasedOnNbOfPastFrame": 5
    }
  },
  "storage": {
    "database": "mongo",
    "database_params": {
      "mongo": {
        "url": "mongodb://mongo:27017",
        "persistTracker": false
      }
    }
  },
  "ports": {
    "app": 8080,
    "inference_json_stream": 8070,
    "inference_mjpeg_stream": 8090
  }
}
